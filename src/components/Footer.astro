---
const today = new Date();
---
<footer>
	<div class="footer-inner">
		<span>© {today.getFullYear()} 도현의 개발 노트</span>
		<span class="dot">·</span>
		<a href="https://github.com/xdswwwj" target="_blank" rel="noopener">GitHub</a>
		<span class="dot">·</span>
		<span>Astro로 제작</span>
	</div>
</footer>
<style>
	footer {
		flex-shrink: 0;
		padding: 2.5em 1em 3em 1em;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.9rem;
		border-top: 1px solid var(--border);
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5em;
	}
	.dot { color: var(--border); }
	footer a { color: var(--text-muted); text-decoration: none; }
	footer a:hover { color: var(--accent); }
</style>
