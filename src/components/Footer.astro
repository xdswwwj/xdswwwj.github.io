---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap footer-in">
		<div>
			<div class="f-name">{SITE_TITLE}</div>
			<p class="f-desc">{SITE_DESCRIPTION}</p>
		</div>
		<div class="f-right">
			<nav aria-label="바닥 링크">
				<a href="/about">소개</a>
				<a href="/rss.xml">RSS</a>
				<a href="https://github.com/xdswwwj" target="_blank" rel="noopener">GitHub</a>
			</nav>
			<div class="f-copy num">© {year} {SITE_TITLE}</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		flex-shrink: 0;
		margin-top: var(--sp-16);
		padding: var(--sp-8) 0 var(--sp-10);
		border-top: 1px solid var(--line);
	}
	.footer-in {
		display: flex;
		flex-direction: column;
		gap: var(--sp-3);
	}
	.f-name {
		font-size: var(--fs-body);
		font-weight: 700;
		color: var(--ink);
	}
	.f-desc {
		margin-top: 2px;
		font-size: var(--fs-sub);
		color: var(--soft);
	}
	nav {
		display: flex;
		gap: var(--sp-4);
		font-size: var(--fs-sub);
	}
	nav a {
		color: var(--soft);
	}
	nav a:hover {
		color: var(--ink);
	}
	.f-copy {
		margin-top: var(--sp-2);
		font-size: var(--fs-sub);
		color: var(--soft);
	}
	@media (min-width: 720px) {
		.footer-in {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
			gap: var(--sp-8);
		}
		.f-right {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: var(--sp-2);
			flex: none;
		}
		.f-copy {
			margin-top: 0;
		}
	}
</style>
