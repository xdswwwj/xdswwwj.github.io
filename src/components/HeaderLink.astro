---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	/** Extra first path segments that should also mark this link as current (e.g. ['tags']). */
	match?: string[];
};

const { href, class: className, match = [], ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const first = pathname.match(/[^\/]+/g)?.[0] || '';
const target = String(href ?? '').replace(/^\/|\/$/g, '');
const isActive = target === first || match.includes(first);
---

<a href={href} class={className} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
