---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const links = [
	{ href: '/blog', label: '글' },
	{ href: '/categories', label: '카테고리', match: ['tags'] },
	{ href: '/about', label: '소개' },
];
const chevron =
	'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>';
---

<header class="site-header">
	<div class="wrap header-in">
		<a class="logo" href="/">{SITE_TITLE}</a>
		<nav class="nav" aria-label="주 메뉴">
			{links.map((l) => <HeaderLink href={l.href} match={l.match}>{l.label}</HeaderLink>)}
		</nav>
		<button id="theme-toggle" class="icon-btn" type="button" aria-label="테마 바꾸기">
			<svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
			<svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
		</button>
		<button
			id="menu-toggle"
			class="icon-btn menu-btn"
			type="button"
			aria-label="메뉴 열기"
			aria-expanded="false"
			aria-controls="drawer"
		>
			<svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			<svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
		</button>
	</div>

	<div class="dim" id="drawer-dim" hidden></div>
	<nav class="drawer" id="drawer" aria-label="메뉴" hidden>
		{
			links.map((l) => (
				<HeaderLink href={l.href} match={l.match}>
					{l.label}
					<Fragment set:html={chevron} />
				</HeaderLink>
			))
		}
	</nav>
</header>

<script is:inline>
	(() => {
		const theme = document.getElementById('theme-toggle');
		if (theme) {
			theme.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				localStorage.setItem('theme', next);
			});
		}

		const btn = document.getElementById('menu-toggle');
		const drawer = document.getElementById('drawer');
		const dim = document.getElementById('drawer-dim');
		if (!btn || !drawer || !dim) return;
		const set = (open) => {
			drawer.hidden = !open;
			dim.hidden = !open;
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
		};
		btn.addEventListener('click', () => set(drawer.hidden));
		dim.addEventListener('click', () => set(false));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !drawer.hidden) {
				set(false);
				btn.focus();
			}
		});
		matchMedia('(min-width: 720px)').addEventListener('change', (e) => {
			if (e.matches) set(false);
		});
	})();
</script>

<style>
	.site-header {
		position: relative;
		z-index: 40;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	.header-in {
		position: relative;
		z-index: 3;
		background: var(--bg);
		display: flex;
		align-items: center;
		gap: var(--sp-2);
		height: 56px;
	}
	.logo {
		margin-right: auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
	.logo:hover {
		color: var(--ink);
	}

	.nav {
		display: none;
		gap: var(--sp-1);
		margin-right: var(--sp-2);
	}
	.nav :global(a) {
		padding: 6px 10px;
		border-radius: var(--r-btn);
		font-size: var(--fs-ui);
		font-weight: 500;
		color: var(--soft);
		transition: background-color 0.15s ease, color 0.15s ease;
	}
	.nav :global(a:hover) {
		background: var(--fill);
		color: var(--ink);
	}
	.nav :global(a[aria-current='page']) {
		color: var(--ink);
		font-weight: 700;
	}

	.icon-btn {
		display: grid;
		place-items: center;
		flex: none;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: var(--r-btn);
		background: transparent;
		color: var(--soft);
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
	}
	.icon-btn:hover {
		background: var(--fill);
		color: var(--ink);
	}
	.icon-btn:active {
		transform: scale(0.96);
	}
	.icon-sun,
	.icon-moon,
	.icon-close {
		display: none;
	}
	:global(html[data-theme='light']) .icon-sun,
	:global(html[data-theme='dark']) .icon-moon {
		display: block;
	}
	.menu-btn[aria-expanded='true'] .icon-open {
		display: none;
	}
	.menu-btn[aria-expanded='true'] .icon-close {
		display: block;
	}

	/* 폰 서랍 메뉴 */
	.drawer {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		z-index: 2;
		padding: var(--sp-2) var(--gutter) var(--sp-5);
		background: var(--bg);
		border-bottom: 1px solid var(--line);
		box-shadow: var(--shadow-float);
	}
	.drawer[hidden],
	.dim[hidden] {
		display: none;
	}
	.drawer :global(a) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 52px;
		padding: 0 var(--sp-3);
		border-radius: 10px;
		font-size: 17px;
		font-weight: 600;
		color: var(--ink-2);
	}
	.drawer :global(a:hover) {
		background: var(--fill);
	}
	.drawer :global(a[aria-current='page']) {
		background: var(--fill);
		color: var(--ink);
		font-weight: 700;
	}
	.drawer :global(svg) {
		color: var(--faint);
	}
	.dim {
		position: fixed;
		inset: 0;
		z-index: 1;
		background: var(--dim);
	}

	@media (min-width: 720px) {
		.header-in {
			height: 64px;
		}
		.nav {
			display: flex;
		}
		.menu-btn,
		.drawer,
		.dim {
			display: none !important;
		}
	}
</style>
