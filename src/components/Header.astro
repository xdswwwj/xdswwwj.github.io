---
// 검은 머리줄 — 왼쪽 글자 로고, 오른쪽 메뉴, 테두리 버튼 하나 (참고: 풀링포레스트)
const links = [
	{ href: '/blog/', label: '글' },
	{ href: '/categories/', label: '분류' },
	{ href: '/about/', label: '소개' },
];
const path = Astro.url.pathname;
const on = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
	<div class="wrap header-in">
		<a class="logo" href="/" aria-label="처음으로">dev<span>-do</span></a>
		<nav class="nav" aria-label="주 메뉴">
			{links.map((l) => <a href={l.href} class:list={[{ on: on(l.href) }]}>{l.label}</a>)}
			<a class="btn-line nav-cta" href="https://github.com/xdswwwj" target="_blank" rel="noopener">GitHub</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(0, 0, 0, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line-soft);
	}
	.header-in { display: flex; align-items: center; justify-content: space-between; height: 64px; }
	.logo { font-size: 21px; font-weight: 700; letter-spacing: -0.04em; color: var(--ink); }
	.logo span { font-weight: 300; }
	.nav { display: flex; align-items: center; gap: 30px; }
	.nav a:not(.btn-line) { font-size: 14.5px; font-weight: 500; color: var(--ink-2); transition: color 0.15s; }
	.nav a:not(.btn-line):hover, .nav a.on { color: var(--ink); }
	.nav-cta { margin-left: 6px; }
	@media (max-width: 640px) {
		.header-in { height: 56px; }
		.nav { gap: 18px; }
		.nav-cta { display: none; }
	}
</style>
