---
import { SITE_TIME_ZONE } from '../lib/posts-pure.mjs';

interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('ko-KR', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			timeZone: SITE_TIME_ZONE,
		})
	}
</time>
