---
import { getSortedPosts, readingTime } from '../../lib/posts';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	const categories = [...new Set(posts.map((p) => p.data.category))];
	return categories.map((category) => ({
		params: { category },
		props: {
			category,
			posts: posts
				.filter((p) => p.data.category === category),
		},
	}));
}

const { category, posts } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${category} · ${SITE_TITLE}`} description={`${category} 카테고리의 글`} />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<header class="page-head">
				<a class="back" href="/categories/">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
					카테고리
				</a>
				<h1>{category}</h1>
				<p class="num">{posts.length}개의 글</p>
			</header>
			<ul class="post-rows list">
				{
					posts.map((post) => {
						const d = post.data.pubDate;
						return (
							<li class="post-row">
								<a href={`/blog/${post.id}/`}>
									<time class="d num" datetime={d.toISOString()}>
										{pad(d.getMonth() + 1)}.{pad(d.getDate())}
									</time>
									<span class="t">{post.data.title}</span>
									<span class="s">{post.data.description}</span>
									<span class="m num">
										<span class="pd">{d.getFullYear()}년 {d.getMonth() + 1}월 {d.getDate()}일</span>
										<span class="dot" />
										<span>{readingTime(post.body).replace('약 ', '')}</span>
									</span>
								</a>
							</li>
						);
					})
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.back {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		margin-bottom: var(--sp-4);
		font-size: var(--fs-ui);
		color: var(--soft);
	}
	.back:hover {
		color: var(--ink);
	}
	.list {
		border-top: 1px solid var(--line);
	}
</style>
