---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`페이지를 찾을 수 없어요 · ${SITE_TITLE}`} description="요청하신 페이지가 존재하지 않습니다." />
	</head>
	<body>
		<Header />
		<main>
			<section class="notfound">
				<div class="glow" aria-hidden="true"></div>
				<p class="code gradient-text">404</p>
				<h1>페이지를 찾을 수 없어요</h1>
				<p class="desc">
					주소가 바뀌었거나, 삭제된 글일 수 있어요.<br />
					아래 링크로 이동해 보세요.
				</p>
				<div class="cta">
					<a class="btn" href="/">홈으로</a>
					<a class="btn ghost" href="/blog">전체 글 보기</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.notfound {
		position: relative;
		text-align: center;
		padding: 4rem 0 5rem;
		overflow: hidden;
	}
	.glow {
		position: absolute;
		top: -80px;
		left: 50%;
		transform: translateX(-50%);
		width: 520px;
		height: 360px;
		background: radial-gradient(ellipse at center, var(--glow) 0%, transparent 70%);
		filter: blur(40px);
		pointer-events: none;
		z-index: -1;
	}
	.code {
		font-size: clamp(4rem, 16vw, 7rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.04em;
		margin: 0 0 0.5rem;
	}
	.notfound h1 {
		font-size: clamp(1.5rem, 5vw, 2rem);
		margin-bottom: 0.75rem;
	}
	.desc {
		color: var(--text-muted);
		margin-bottom: 2rem;
		line-height: 1.7;
	}
	.cta {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.65rem 1.3rem;
		border-radius: 12px;
		font-size: 0.95rem;
		font-weight: 600;
		background: var(--accent-gradient);
		color: var(--on-accent);
		border: 1px solid transparent;
		box-shadow: 0 6px 20px rgba(var(--accent-rgb), 0.3);
		transition: transform 0.1s ease, box-shadow 0.15s ease;
	}
	.btn:hover {
		color: var(--on-accent);
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: 0 10px 28px rgba(var(--accent-rgb), 0.4);
	}
	.btn.ghost {
		background: var(--surface-2);
		color: var(--text);
		border-color: var(--border);
		box-shadow: none;
	}
	.btn.ghost:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
</style>
