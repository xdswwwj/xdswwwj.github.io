---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`페이지를 찾을 수 없어요 · ${SITE_TITLE}`} description="요청하신 페이지가 존재하지 않습니다." />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<section class="notfound">
				<p class="code num">404</p>
				<h1>페이지를 찾을 수 없어요</h1>
				<p class="desc">
					주소가 바뀌었거나, 삭제된 글일 수 있어요.<br />
					아래 링크로 이동해 보세요.
				</p>
				<div class="cta">
					<a class="btn" href="/">홈으로</a>
					<a class="btn sub" href="/blog">전체 글 보기</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.notfound {
		padding: var(--sp-16) 0 var(--sp-10);
		text-align: center;
	}
	.code {
		margin-bottom: var(--sp-2);
		font-size: 16px;
		font-weight: 700;
		color: var(--accent);
	}
	h1 {
		font-size: 28px;
		letter-spacing: var(--ls-title);
	}
	.desc {
		margin-top: var(--sp-3);
		font-size: var(--fs-body);
		line-height: 1.7;
		color: var(--soft);
	}
	.cta {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
		margin-top: var(--sp-8);
	}
	.btn {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 52px;
		padding: 0 var(--sp-6);
		border-radius: var(--r-card);
		background: var(--accent);
		color: var(--on-accent);
		font-size: 16px;
		font-weight: 600;
		transition: background-color 0.15s ease, transform 0.1s ease;
	}
	.btn:hover {
		background: var(--accent-hover);
		color: var(--on-accent);
	}
	.btn.sub {
		background: var(--fill);
		color: var(--ink-2);
	}
	.btn.sub:hover {
		background: var(--fill-strong);
		color: var(--ink-2);
	}
	.btn:active {
		transform: scale(0.98);
	}
	@media (min-width: 720px) {
		.notfound {
			padding-top: 120px;
		}
		h1 {
			font-size: 32px;
		}
		.cta {
			flex-direction: row;
			justify-content: center;
		}
		.btn {
			min-width: 160px;
		}
	}
</style>
