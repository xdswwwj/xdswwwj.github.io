---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [...new Set(posts.map((p) => p.data.category))];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`글 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<span class="kicker">글 목록</span>
				<h1>전체 <span class="gradient-text">글</span></h1>
				<p>{posts.length}개의 글</p>
			</header>

			<div class="search">
				<svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
				<input
					id="search-input"
					type="search"
					placeholder="제목·내용·카테고리 검색…"
					autocomplete="off"
					aria-label="글 검색"
				/>
			</div>

			<div class="filters" role="group" aria-label="카테고리 필터">
				<button class="filter active" data-cat="" type="button">전체</button>
				{
					categories.map((c) => (
						<button class="filter" data-cat={c} type="button">
							{c}
						</button>
					))
				}
			</div>

			<ul class="post-list" id="post-list">
				{
					posts.map((post) => (
						<li
							class="post-item"
							data-title={post.data.title.toLowerCase()}
							data-desc={post.data.description.toLowerCase()}
							data-cat={post.data.category}
						>
							<a href={`/blog/${post.id}/`}>
								<div class="meta">
									<span class="cat">{post.data.category}</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2 class="title">{post.data.title}</h2>
								<p class="excerpt">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
			<p class="empty" id="empty" hidden>검색 결과가 없습니다.</p>
		</main>
		<Footer />
		<script is:inline>
			(() => {
				const input = document.getElementById('search-input');
				const list = document.getElementById('post-list');
				const empty = document.getElementById('empty');
				const filters = [...document.querySelectorAll('.filter')];
				const items = [...document.querySelectorAll('.post-item')];
				let query = '';
				let cat = '';

				const apply = () => {
					let visible = 0;
					items.forEach((el) => {
						const matchCat = !cat || el.dataset.cat === cat;
						const matchQuery =
							!query ||
							el.dataset.title.includes(query) ||
							el.dataset.desc.includes(query) ||
							el.dataset.cat.toLowerCase().includes(query);
						const show = matchCat && matchQuery;
						el.hidden = !show;
						if (show) visible++;
					});
					empty.hidden = visible !== 0;
				};

				input.addEventListener('input', (e) => {
					query = e.target.value.trim().toLowerCase();
					apply();
				});
				filters.forEach((btn) => {
					btn.addEventListener('click', () => {
						filters.forEach((b) => b.classList.remove('active'));
						btn.classList.add('active');
						cat = btn.dataset.cat;
						apply();
					});
				});
			})();
		</script>
	</body>
</html>

<style>
	.page-head {
		margin-bottom: 1.75rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}
	.kicker {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}
	.page-head h1 {
		margin-bottom: 0.25rem;
		font-size: 2.4rem;
		letter-spacing: -0.03em;
	}
	.page-head p {
		margin: 0;
		color: var(--text-muted);
	}

	.search {
		position: relative;
		margin-bottom: 1rem;
	}
	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted);
		pointer-events: none;
	}
	#search-input {
		width: 100%;
		padding: 0.8rem 1rem 0.8rem 2.8rem;
		font-size: 0.98rem;
		color: var(--text);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	#search-input::placeholder { color: var(--text-muted); }
	#search-input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.15);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.75rem;
	}
	.filter {
		padding: 0.4rem 0.85rem;
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--text-muted);
		background: var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 999px;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
	}
	.filter:hover { color: var(--text); border-color: var(--accent); }
	.filter.active {
		color: #fff;
		background: var(--accent-gradient);
		border-color: transparent;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.post-item[hidden] { display: none; }
	.post-list li a {
		display: block;
		padding: 1.2rem 1.35rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
	}
	.post-list li a:hover {
		border-color: rgba(var(--accent-rgb), 0.5);
		box-shadow: var(--box-shadow);
		text-decoration: none;
		transform: translateY(-2px);
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 0.35rem;
	}
	.cat {
		color: var(--accent);
		font-weight: 600;
	}
	.title {
		margin: 0 0 0.35rem;
		font-size: 1.3rem;
	}
	.post-list li a:hover .title {
		color: var(--accent);
	}
	.excerpt {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}
	.empty {
		text-align: center;
		color: var(--text-muted);
		padding: 3rem 0;
	}
</style>
