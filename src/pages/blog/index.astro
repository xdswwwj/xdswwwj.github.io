---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`글 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<span class="kicker">ARCHIVE</span>
				<h1>전체 <span class="gradient-text">글</span></h1>
				<p>{posts.length}개의 글</p>
			</header>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<div class="meta">
									<span class="cat">{post.data.category}</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2 class="title">{post.data.title}</h2>
								<p class="excerpt">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		margin-bottom: 2rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}
	.kicker {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}
	.page-head h1 {
		margin-bottom: 0.25rem;
		font-size: 2.4rem;
		letter-spacing: -0.03em;
	}
	.page-head p {
		margin: 0;
		color: var(--text-muted);
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.post-list li a {
		display: block;
		padding: 1.2rem 1.35rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
	}
	.post-list li a:hover {
		border-color: rgba(var(--accent-rgb), 0.5);
		box-shadow: var(--box-shadow);
		text-decoration: none;
		transform: translateY(-2px);
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 0.35rem;
	}
	.cat {
		color: var(--accent);
		font-weight: 600;
	}
	.title {
		margin: 0 0 0.35rem;
		font-size: 1.3rem;
	}
	.post-list li a:hover .title {
		color: var(--accent);
	}
	.excerpt {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}
</style>
