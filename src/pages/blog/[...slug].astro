---
import { type CollectionEntry, render } from 'astro:content';
import { getSortedPosts, getPrevNext, getRelated, readingTime as getReadingTime } from '../../lib/posts';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return Promise.all(posts.map(async (post) => {
		const { prev: older, next: newer } = await getPrevNext(post.id, posts);
		const related = await getRelated(post, 3, posts);
		return {
			params: { slug: post.id },
			props: { post, newer, older, related },
		};
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
	related: CollectionEntry<'blog'>[];
};

const { post, newer, older, related } = Astro.props;
const { Content, headings } = await render(post);

// Keep the layout's existing numeric prop and “N분 읽기” presentation.
const readingTime = Number.parseInt(getReadingTime(post.body).replace('약 ', ''), 10);

// Auto-generated OG image (falls back inside BaseHead if hero image set)
const ogImage = post.data.heroImage ? undefined : `/og/${post.id}.png`;
---

<BlogPost
	{...post.data}
	readingTime={readingTime}
	headings={headings}
	ogImage={ogImage}
	newer={newer}
	older={older}
	related={related}
>
	<Content />
</BlogPost>
