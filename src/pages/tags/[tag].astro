---
import { formatDotDate, getSortedPosts } from '../../lib/posts';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	const counts = new Map<string, number>();
	for (const p of posts) for (const t of p.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
	const allTags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
	return allTags.map(([tag]) => ({
		params: { tag },
		props: {
			tag,
			allTags,
			posts: posts
				.filter((p) => (p.data.tags ?? []).includes(tag)),
		},
	}));
}

const { tag, allTags, posts } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`#${tag} · ${SITE_TITLE}`} description={`#${tag} 태그의 글`} />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<header class="page-head">
				<h1>태그</h1>
				<p>태그를 고르면 그 태그가 붙은 글을 모아 보여줘요.</p>
			</header>
			<ul class="chips">
				{
					allTags.map(([name, count]) => (
						<li>
							<a
								class:list={['chip', { on: name === tag }]}
								href={`/tags/${encodeURIComponent(name)}/`}
								aria-current={name === tag ? 'page' : undefined}
							>
								#{name} <small>{count}</small>
							</a>
						</li>
					))
				}
			</ul>

			<section class="tag-result" aria-labelledby="result-title">
				<h2 id="result-title" class="num">#{tag} · {posts.length}개의 글</h2>
				<ul class="rows">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="rt">{post.data.title}</span>
									<time class="rd" datetime={post.data.pubDate.toISOString()}>{formatDotDate(post.data.pubDate)}</time>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tag-result {
		margin-top: var(--sp-8);
		padding: var(--sp-5) var(--sp-5) var(--sp-2);
		background: var(--bg-sub);
		border: 1px solid var(--line);
		border-radius: var(--r-card);
	}
	.tag-result h2 {
		margin-bottom: var(--sp-1);
		font-size: var(--fs-body);
	}
	.tag-result li:last-child a {
		border-bottom: 0;
	}
</style>
