---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main { width: 100%; max-width: 100%; margin: 0; padding: 0; }
			.hero-image { width: 100%; max-width: 1020px; margin: 2rem auto 0; padding: 0 1em; }
			.hero-image img { display: block; margin: 0 auto; border-radius: 14px; box-shadow: var(--box-shadow); }
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3rem 1em;
				color: var(--text);
			}
			.title { margin-bottom: 2.5rem; }
			.title h1 { margin: 0; font-size: clamp(2rem, 5vw, 2.6rem); letter-spacing: -0.03em; line-height: 1.15; }
			.date { display: flex; align-items: center; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.9rem; font-size: 0.9rem; color: var(--text-muted); }
			.date a { color: var(--accent); text-decoration: none; font-weight: 600; }
			.cat-pill {
				display: inline-flex;
				align-items: center;
				padding: 0.2rem 0.7rem;
				border-radius: 999px;
				background: rgba(var(--accent-rgb), 0.12);
				font-size: 0.82rem;
			}
			.cat-pill:hover { background: rgba(var(--accent-rgb), 0.2); text-decoration: none; }
			.last-updated-on { font-style: italic; margin-top: 0.25rem; }
			.title hr { margin: 1.5rem 0 0; }
			.prose :global(p) { line-height: 1.8; }
			.prose :global(h2) { margin-top: 2.5rem; }
			.prose :global(img) { box-shadow: var(--box-shadow); }
			.prose :global(pre.mermaid) {
				border: none;
				background: none;
				padding: 0;
				text-align: center;
				display: flex;
				justify-content: center;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<a class="cat-pill" href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										· Updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			import mermaid from 'mermaid';
			mermaid.initialize({ startOnLoad: false, theme: 'default' });
			if (document.querySelector('.mermaid')) {
				mermaid.run({ querySelector: '.mermaid' });
			}
		</script>
	</body>
</html>
