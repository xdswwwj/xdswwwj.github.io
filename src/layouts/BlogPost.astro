---
// 글 화면 — 참고: 풀링포레스트 글
// 꽉 찬 표지(어두운 덮개) 위에 분류 배지 · 가는 큰 제목 · 요약 · 가는 줄 · 글쓴이, 아래는 가운데 한 줄 본문
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Cover from '../components/Cover.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { formatDotDate } from '../lib/posts';

type Heading = { depth: number; slug: string; text: string };
type Props = Omit<CollectionEntry<'blog'>['data'], 'draft' | 'tags'> & {
	draft?: boolean;
	tags?: string[];
	readingTime?: number;
	headings?: Heading[];
	ogImage?: string;
	newer?: CollectionEntry<'blog'> | null;
	older?: CollectionEntry<'blog'> | null;
	related?: CollectionEntry<'blog'>[];
};

const { title, description, pubDate, updatedDate, heroImage, category, tags = [], readingTime, ogImage, newer, older, related = [] } = Astro.props;
const isArticle = readingTime !== undefined;
const catHref = `/categories/${encodeURIComponent(category)}/`;
const seed = Astro.url.pathname;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={heroImage} ogImage={ogImage}
			type={isArticle ? 'article' : 'website'} pubDate={pubDate} updatedDate={updatedDate} category={category} />
	</head>
	<body>
		<Header />
		<main>
			<section class:list={['post-hero', { plain: !isArticle }]}>
				{isArticle && <Cover image={heroImage} seed={seed} class="post-hero-bg" eager />}
				{isArticle && <div class="post-hero-shade" />}
				<div class="col post-hero-in">
					{isArticle && <a class="badge" href={catHref}>{category}</a>}
					<h1>{title}</h1>
					<p class="post-lead">{description}</p>
					{isArticle && (
						<div class="byline">
							<p class="who">김도현</p>
							<p class="role">풀스택 개발자 · {formatDotDate(pubDate)}{readingTime ? ` · ${readingTime}분 읽기` : ''}</p>
						</div>
					)}
				</div>
			</section>

			<article class="col prose">
				<slot />
			</article>

			{isArticle && tags.length > 0 && (
				<div class="col post-tags">
					{tags.map((t) => <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
				</div>
			)}

			{isArticle && (newer || older) && (
				<nav class="col post-nav" aria-label="이전·다음 글">
					{older ? <a href={`/blog/${older.id}/`}><span class="lbl">← 이전 글</span><span class="t">{older.data.title}</span></a> : <span />}
					{newer ? <a class="next" href={`/blog/${newer.id}/`}><span class="lbl">다음 글 →</span><span class="t">{newer.data.title}</span></a> : <span />}
				</nav>
			)}

			{isArticle && related.length > 0 && (
				<section class="wrap related">
					<p class="eyebrow">Related</p>
					<div class="related-grid">
						{related.map((p) => (
							<a class="rel" href={`/blog/${p.id}/`}>
								<Cover image={p.data.heroImage} seed={`/blog/${p.id}/`} class="rel-thumb" sizes="(min-width: 960px) 380px, 100vw">
									<span class="badge-on">{p.data.category}</span>
								</Cover>
								<h3>{p.data.title}</h3>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />

		<script>
			import mermaid from 'mermaid';
			const nodes = [...document.querySelectorAll<HTMLElement>('.prose pre.mermaid')];
			if (nodes.length) {
				mermaid.initialize({
					startOnLoad: false, theme: 'base',
					themeVariables: {
						darkMode: true, fontFamily: getComputedStyle(document.body).fontFamily, fontSize: '14px',
						background: '#0a0a0b', primaryColor: '#141416', primaryBorderColor: '#3f3f46', primaryTextColor: '#fafafa',
						secondaryColor: '#18181b', tertiaryColor: '#27272a', mainBkg: '#141416', nodeBorder: '#3f3f46',
						textColor: '#d4d4d8', lineColor: '#71717a', clusterBkg: '#0a0a0b', clusterBorder: '#27272a', edgeLabelBackground: '#0a0a0b',
						actorBkg: '#141416', actorBorder: '#3f3f46', actorTextColor: '#fafafa', signalColor: '#a1a1aa', signalTextColor: '#d4d4d8',
						noteBkgColor: '#18181b', noteBorderColor: '#52525b', noteTextColor: '#fafafa',
					},
				});
				mermaid.run({ nodes });
			}
		</script>
	</body>
</html>

<style>
	.post-hero { position: relative; display: flex; align-items: flex-end; min-height: 560px; border-bottom: 1px solid var(--line-soft); }
	.post-hero.plain { min-height: 0; }
	.post-hero :global(.post-hero-bg) { position: absolute; inset: 0; }
	.post-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.6) 50%, rgba(0,0,0,0.92) 100%); }
	.post-hero-in { position: relative; padding-top: 140px; padding-bottom: 56px; }
	.plain .post-hero-in { padding-top: 88px; padding-bottom: 40px; }
	.post-hero h1 { margin: 20px 0 0; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.24; font-weight: 300; letter-spacing: -0.025em; color: var(--ink); }
	.plain h1 { margin-top: 0; }
	.post-lead { margin: 22px 0 0; max-width: 680px; font-size: 17px; line-height: 1.75; color: var(--ink-2); opacity: 0.85; }
	.byline { margin-top: 36px; padding-top: 22px; border-top: 1px solid var(--line-soft); }
	.who { margin: 0; font-size: 14.5px; font-weight: 600; color: var(--ink); }
	.role { margin: 2px 0 0; font-size: 13.5px; color: var(--faint); font-variant-numeric: tabular-nums; }

	/* 본문 */
	.prose { padding-top: 72px; font-size: 16.5px; line-height: 1.95; color: var(--ink-2); }
	.prose :global(p) { margin: 0 0 26px; }
	.prose :global(h2) { margin: 72px 0 20px; font-size: 28px; line-height: 1.4; font-weight: 400; letter-spacing: -0.015em; color: var(--ink); }
	.prose :global(h3) { margin: 48px 0 14px; font-size: 21px; line-height: 1.45; font-weight: 500; color: var(--ink); }
	.prose :global(strong) { color: var(--ink); font-weight: 600; }
	.prose :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(255,255,255,0.4); }
	.prose :global(img) { width: 100%; margin: 40px 0; }
	.prose :global(blockquote) { margin: 40px 0; padding: 2px 0 2px 22px; border-left: 1px solid #71717a; font-style: italic; color: var(--soft); }
	.prose :global(blockquote p) { margin: 0; }
	.prose :global(ul), .prose :global(ol) { margin: 0 0 26px; padding-left: 22px; }
	.prose :global(li) { margin: 6px 0; }
	.prose :global(hr) { margin: 56px 0; border: 0; border-top: 1px solid var(--line); }
	.prose :global(code) { font-family: var(--font-mono); font-size: 0.88em; padding: 2px 6px; background: var(--panel); border-radius: 4px; color: var(--ink); }
	.prose :global(pre) { margin: 32px 0; padding: 20px 22px; overflow-x: auto; background: var(--bg-2) !important; border: 1px solid var(--line); border-radius: 6px; font-size: 14px; line-height: 1.7; }
	.prose :global(pre code) { padding: 0; background: none; }
	.prose :global(pre.mermaid) { display: flex; justify-content: center; text-align: center; font-family: var(--font); }
	.prose :global(pre.mermaid:not([data-processed])) { color: transparent; }
	.prose :global(table) { width: 100%; margin: 32px 0; border-collapse: collapse; font-size: 15px; }
	.prose :global(th), .prose :global(td) { padding: 12px 14px; border-bottom: 1px solid var(--line); text-align: left; }
	.prose :global(th) { color: var(--ink); font-weight: 600; }

	.post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
	.post-tags a { padding: 4px 12px; border: 1px solid var(--line); font-size: 13px; color: var(--soft); }
	.post-tags a:hover { color: var(--ink); border-color: var(--faint); }

	.post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--line); }
	.post-nav a { display: flex; flex-direction: column; gap: 8px; }
	.post-nav .next { text-align: right; }
	.post-nav .lbl { font-size: 13px; color: var(--faint); }
	.post-nav .t { font-size: 16px; font-weight: 500; color: var(--ink); line-height: 1.45; }
	.post-nav a:hover .t { text-decoration: underline; text-underline-offset: 4px; }

	.related { margin-top: 96px; }
	.related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 18px; }
	.rel :global(.rel-thumb) { aspect-ratio: 16 / 10; }
	.rel h3 { margin: 14px 0 0; font-size: 18px; line-height: 1.45; font-weight: 500; color: var(--ink); }
	.rel:hover h3 { text-decoration: underline; text-underline-offset: 4px; }

	@media (max-width: 760px) {
		.post-hero { min-height: 460px; }
		.post-hero-in { padding-top: 100px; padding-bottom: 40px; }
		.post-lead { font-size: 15.5px; }
		.prose { padding-top: 48px; font-size: 16px; line-height: 1.9; }
		.prose :global(h2) { font-size: 24px; margin-top: 56px; }
		.related-grid { grid-template-columns: 1fr; gap: 32px; }
		.post-nav { grid-template-columns: 1fr; }
		.post-nav .next { text-align: left; }
	}
</style>
