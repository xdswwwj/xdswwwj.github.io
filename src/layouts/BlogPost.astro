---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

type Heading = { depth: number; slug: string; text: string };

type Props = Omit<CollectionEntry<'blog'>['data'], 'draft' | 'tags'> & {
	draft?: boolean;
	tags?: string[];
	readingTime?: number;
	headings?: Heading[];
	ogImage?: string;
	newer?: CollectionEntry<'blog'> | null;
	older?: CollectionEntry<'blog'> | null;
	related?: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	readingTime,
	headings = [],
	ogImage,
	newer,
	older,
	related = [],
} = Astro.props;

const isArticle = readingTime !== undefined;
const toc = isArticle ? headings.filter((h) => h.depth === 2 || h.depth === 3) : [];
const hasToc = toc.length > 1;
const pad = (n: number) => String(n).padStart(2, '0');
const dotDate = (d: Date) => `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
const categoryHref = `/categories/${encodeURIComponent(category)}/`;
---

<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			ogImage={ogImage}
			type={isArticle ? 'article' : 'website'}
			pubDate={pubDate}
			updatedDate={updatedDate}
			category={category}
		/>
	</head>

	<body>
		<Header />
		<main class="wrap">
			<header class="p-head">
				{
					isArticle && (
						<a class="p-back" href="/blog">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
							글 목록
						</a>
					)
				}
				<h1 class="p-title">{title}</h1>
				{description && <p class="p-desc">{description}</p>}
				{
					isArticle && (
						<div class="p-meta num">
							<FormattedDate date={pubDate} />
							<span class="dot" />
							<a href={categoryHref}>{category}</a>
							<span class="dot" />
							<span>{readingTime}분 읽기</span>
							{updatedDate && (
								<>
									<span class="dot" />
									<span>
										수정 <FormattedDate date={updatedDate} />
									</span>
								</>
							)}
						</div>
					)
				}
			</header>
			<hr class="p-rule" />

			<div class="p-body">
				{
					hasToc && (
						<aside class="toc-rail">
							<nav class="toc" aria-label="목차">
								<p>목차</p>
								<ol>
									{toc.map((h) => (
										<li class={h.depth === 3 ? 'sub' : undefined}>
											<a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)
				}
				{
					hasToc && (
						<details class="toc-m">
							<summary>
								목차
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
							</summary>
							<ol>
								{toc.map((h) => (
									<li class={h.depth === 3 ? 'sub' : undefined}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
						</details>
					)
				}
				<article class="prose">
					<slot />
				</article>
			</div>

			{
				isArticle && tags.length > 0 && (
					<ul class="chips p-tags" aria-label="태그">
						{tags.map((t) => (
							<li>
								<a class="chip" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>
							</li>
						))}
					</ul>
				)
			}

			{
				isArticle && (
					<section class="author" aria-label="글쓴이">
						<div class="av" aria-hidden="true">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
						</div>
						<div class="author-body">
							<div class="nm">{SITE_TITLE}</div>
							<p class="bio">{SITE_DESCRIPTION}</p>
							<div class="lk">
								<a href="/about">소개 보기</a>
								<a href="https://github.com/xdswwwj" target="_blank" rel="noopener">GitHub</a>
								<a href="/rss.xml">RSS</a>
							</div>
						</div>
					</section>
				)
			}

			{
				isArticle && (older || newer) && (
					<nav class="pn" aria-label="이전·다음 글">
						{older && (
							<a href={`/blog/${older.id}/`}>
								<span class="lb">← 이전 글</span>
								<span class="tt">{older.data.title}</span>
							</a>
						)}
						{newer && (
							<a class:list={['next', { solo: !older }]} href={`/blog/${newer.id}/`}>
								<span class="lb">다음 글 →</span>
								<span class="tt">{newer.data.title}</span>
							</a>
						)}
					</nav>
				)
			}

			{
				isArticle && related.length > 0 && (
					<section aria-labelledby="related-title">
						<h2 class="sec-title" id="related-title">관련 글</h2>
						<ul class="rows">
							{related.map((r) => (
								<li>
									<a href={`/blog/${r.id}/`}>
										<span class="rt">{r.data.title}</span>
										<span class="rd">{dotDate(r.data.pubDate)}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />

		<script is:inline>
			(() => {
				// 코드 블록: 언어 이름 + 복사 버튼
				document.querySelectorAll('.prose pre.astro-code').forEach((pre) => {
					const wrap = document.createElement('div');
					wrap.className = 'code-block';
					const bar = document.createElement('div');
					bar.className = 'code-toolbar';
					const label = document.createElement('span');
					label.className = 'code-lang';
					label.textContent = pre.getAttribute('data-language') || 'code';
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'code-copy';
					btn.textContent = '복사';
					btn.addEventListener('click', async () => {
						const code = pre.querySelector('code')?.innerText ?? pre.innerText;
						try {
							await navigator.clipboard.writeText(code);
							btn.classList.add('copied');
							btn.textContent = '복사했어요';
							setTimeout(() => {
								btn.classList.remove('copied');
								btn.textContent = '복사';
							}, 1600);
						} catch (e) {}
					});
					bar.append(label, btn);
					pre.parentNode.insertBefore(wrap, pre);
					wrap.append(bar, pre);
				});

				// 표: 테두리 상자 안에서만 가로로 넘기기
				document.querySelectorAll('.prose table').forEach((table) => {
					if (table.parentElement.classList.contains('table-wrap')) return;
					const wrap = document.createElement('div');
					wrap.className = 'table-wrap';
					table.parentNode.insertBefore(wrap, table);
					wrap.appendChild(table);
				});

				// 소제목 링크
				document.querySelectorAll('.prose h2[id], .prose h3[id], .prose h4[id]').forEach((h) => {
					const a = document.createElement('a');
					a.className = 'heading-anchor';
					a.href = '#' + h.id;
					a.setAttribute('aria-label', '이 섹션으로 가는 링크');
					a.textContent = '#';
					h.appendChild(a);
				});

				// GitHub 식 callout: > [!NOTE] / [!TIP] / [!IMPORTANT] / [!WARNING] / [!CAUTION]
				const svg = (d) =>
					'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>';
				const calloutMeta = {
					note: { label: '참고', icon: svg('<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>') },
					tip: { label: '팁', icon: svg('<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3Z"/>') },
					important: { label: '중요', icon: svg('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>') },
					warning: { label: '주의', icon: svg('<path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4M12 17h.01"/>') },
					caution: { label: '경고', icon: svg('<circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/>') },
				};
				const calloutRe = /^\s*\[!(note|tip|important|warning|caution)\]\s*(<br\s*\/?>)?\s*/i;
				document.querySelectorAll('.prose blockquote').forEach((bq) => {
					const firstP = bq.querySelector('p');
					if (!firstP) return;
					const m = firstP.textContent.match(/^\s*\[!(note|tip|important|warning|caution)\]/i);
					if (!m) return;
					const type = m[1].toLowerCase();
					firstP.innerHTML = firstP.innerHTML.replace(calloutRe, '');
					if (!firstP.textContent.trim() && !firstP.querySelector('img, code')) firstP.remove();
					bq.classList.add('callout', 'callout-' + type);
					const head = document.createElement('div');
					head.className = 'callout-head';
					head.innerHTML = calloutMeta[type].icon + '<span>' + calloutMeta[type].label + '</span>';
					bq.insertBefore(head, bq.firstChild);
				});

				// 폰 목차: 항목을 누르면 접기
				const tocM = document.querySelector('.toc-m');
				if (tocM) {
					tocM.addEventListener('click', (e) => {
						if (e.target.closest('a')) tocM.open = false;
					});
				}

				// 넓은 화면 목차: 지금 읽는 소제목 표시
				const tocLinks = [...document.querySelectorAll('.toc a[data-slug]')];
				if (tocLinks.length) {
					const targets = tocLinks.map((a) => document.getElementById(a.dataset.slug)).filter(Boolean);
					if (!targets.length) return;
					let current = null;
					const setActive = (id) => {
						if (id === current) return;
						current = id;
						tocLinks.forEach((a) => {
							const on = a.dataset.slug === id;
							a.classList.toggle('on', on);
							if (on) a.setAttribute('aria-current', 'true');
							else a.removeAttribute('aria-current');
						});
					};
					// 짧은 글은 마지막 소제목까지 스크롤이 닿지 않으니, 지점을 비율로 줄여서
					// 모든 소제목이 차례대로 켜지게 해요.
					const doc = document.documentElement;
					let points = [];
					const recalc = () => {
						const max = Math.max(1, doc.scrollHeight - window.innerHeight);
						const line = Math.min(window.innerHeight * 0.3, 140);
						let pts = targets.map((t) => Math.max(0, t.getBoundingClientRect().top + window.scrollY - line));
						const last = pts[pts.length - 1];
						if (last > max) pts = pts.map((p) => (p * max) / last);
						points = pts;
					};
					const spy = () => {
						const y = window.scrollY;
						let idx = 0;
						for (let i = 0; i < points.length; i++) {
							if (y >= points[i] - 1) idx = i;
							else break;
						}
						setActive(targets[idx].id);
					};
					const refresh = () => {
						recalc();
						spy();
					};
					recalc();
					window.addEventListener('scroll', spy, { passive: true });
					window.addEventListener('resize', refresh);
					// mermaid 그림 · 이미지 · 글꼴이 늦게 자리를 잡으면 다시 계산
					window.addEventListener('load', refresh);
					if ('ResizeObserver' in window) new ResizeObserver(refresh).observe(document.body);
					spy();
				}
			})();
		</script>
		<script>
			import mermaid from 'mermaid';

			const nodes = [...document.querySelectorAll<HTMLElement>('.prose pre.mermaid')];
			if (nodes.length) {
				nodes.forEach((n) => (n.dataset.src = n.textContent ?? ''));
				const palette = (dark: boolean) => {
					const c = dark
						? { bg: '#17171C', sub: '#1D1D23', fill: '#2A2A32', line: '#2C2C35', strong: '#44444F', ink: '#F2F3F5', ink2: '#CDD1D6', soft: '#9EA5AF', accent: '#4C97FF', accentSoft: '#1C2A40' }
						: { bg: '#FFFFFF', sub: '#F9FAFB', fill: '#F2F4F6', line: '#E5E8EB', strong: '#D1D6DB', ink: '#191F28', ink2: '#333D4B', soft: '#6B7684', accent: '#3182F6', accentSoft: '#E8F3FF' };
					return {
						darkMode: dark,
						fontFamily: getComputedStyle(document.body).fontFamily,
						fontSize: '14px',
						background: c.bg,
						primaryColor: c.sub,
						primaryBorderColor: c.strong,
						primaryTextColor: c.ink,
						secondaryColor: c.accentSoft,
						tertiaryColor: c.fill,
						mainBkg: c.sub,
						nodeBorder: c.strong,
						textColor: c.ink2,
						lineColor: c.soft,
						clusterBkg: c.sub,
						clusterBorder: c.line,
						edgeLabelBackground: c.bg,
						actorBkg: c.sub,
						actorBorder: c.strong,
						actorTextColor: c.ink,
						actorLineColor: c.strong,
						signalColor: c.soft,
						signalTextColor: c.ink2,
						labelBoxBkgColor: c.fill,
						labelBoxBorderColor: c.strong,
						labelTextColor: c.ink,
						loopTextColor: c.ink2,
						noteBkgColor: c.accentSoft,
						noteBorderColor: c.accent,
						noteTextColor: c.ink,
						activationBkgColor: c.fill,
						activationBorderColor: c.strong,
					};
				};
				let shown: boolean | undefined;
				const render = async () => {
					const dark = document.documentElement.dataset.theme === 'dark';
					if (dark === shown) return;
					shown = dark;
					mermaid.initialize({ startOnLoad: false, theme: 'base', themeVariables: palette(dark) });
					nodes.forEach((n) => {
						n.removeAttribute('data-processed');
						n.textContent = n.dataset.src ?? '';
					});
					await mermaid.run({ nodes });
				};
				render();
				// 테마를 바꾸면 그림도 같은 색으로 다시 그려요
				new MutationObserver(render).observe(document.documentElement, {
					attributes: true,
					attributeFilter: ['data-theme'],
				});
			}
		</script>
	</body>
</html>

<style>
	/* ── 글 머리 ── */
	.p-head {
		padding: var(--sp-8) 0 0;
	}
	.p-back {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		margin-bottom: var(--sp-6);
		font-size: var(--fs-ui);
		color: var(--soft);
	}
	.p-back:hover {
		color: var(--ink);
	}
	.p-title {
		font-size: var(--fs-display);
		line-height: var(--lh-tight);
		letter-spacing: var(--ls-title);
	}
	.p-desc {
		margin-top: var(--sp-3);
		font-size: var(--fs-prose);
		color: var(--soft);
		line-height: var(--lh-body);
	}
	.p-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		margin-top: var(--sp-5);
		font-size: var(--fs-ui);
		color: var(--soft);
	}
	.p-meta a {
		color: var(--ink-2);
		font-weight: 600;
	}
	.p-meta a:hover {
		color: var(--accent);
	}
	.p-rule {
		margin: var(--sp-8) 0;
	}
	.p-body {
		position: relative;
	}

	/* ── 목차: 폰·중간 폭은 접는 상자, 넓은 화면은 오른쪽 여백 ── */
	.toc-rail {
		display: none;
	}
	.toc-m {
		margin-bottom: var(--sp-8);
		background: var(--bg-sub);
		border: 1px solid var(--line);
		border-radius: var(--r-card);
		font-size: var(--fs-ui);
	}
	.toc-m summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--sp-3) var(--sp-4);
		list-style: none;
		font-weight: 600;
		color: var(--ink);
		cursor: pointer;
	}
	.toc-m summary::-webkit-details-marker {
		display: none;
	}
	.toc-m summary svg {
		color: var(--soft);
		transition: transform 0.15s ease;
	}
	.toc-m[open] summary svg {
		transform: rotate(180deg);
	}
	.toc-m ol,
	.toc ol {
		margin: 0;
		padding: 0 var(--sp-4) var(--sp-3);
		list-style: none;
	}
	.toc-m li a,
	.toc li a {
		display: block;
		padding: 5px 0;
		color: var(--soft);
		line-height: 1.5;
	}
	.toc-m li a:hover,
	.toc li a:hover {
		color: var(--ink);
	}
	.toc-m li.sub a,
	.toc li.sub a {
		padding-left: var(--sp-3);
	}
	/* 1200px: 680 본문 + 200 목차 + 사이 48 이 스크롤바가 있어도 화면 안에 들어가는 폭 */
	@media (min-width: 1200px) {
		.toc-m {
			display: none;
		}
		.toc-rail {
			display: block;
			position: absolute;
			top: 0;
			bottom: 0;
			left: calc(100% + 48px);
			width: var(--w-toc);
		}
		.toc {
			position: sticky;
			top: var(--sp-10);
			max-height: calc(100vh - var(--sp-16));
			overflow-y: auto;
			font-size: var(--fs-sub);
			border-left: 1px solid var(--line);
		}
		.toc p {
			margin: 0 0 var(--sp-2);
			padding-left: var(--sp-4);
			font-weight: 700;
			color: var(--ink);
		}
		.toc ol {
			padding: 0 0 0 var(--sp-4);
		}
		.toc li a {
			position: relative;
		}
		.toc li a.on {
			color: var(--accent);
			font-weight: 600;
		}
		.toc li a.on::before {
			content: '';
			position: absolute;
			left: -17px;
			top: 6px;
			bottom: 6px;
			width: 2px;
			background: var(--accent);
		}
		.toc li.sub a.on::before {
			left: -29px;
		}
	}

	/* ── 글 끝 ── */
	.p-tags {
		margin-top: var(--sp-10);
	}
	.author {
		display: flex;
		gap: var(--sp-4);
		margin-top: var(--sp-10);
		padding: var(--sp-6);
		border: 1px solid var(--line);
		border-radius: var(--r-card);
	}
	.author-body {
		min-width: 0;
	}
	.av {
		display: grid;
		place-items: center;
		flex: none;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: var(--fill);
		color: var(--faint);
	}
	.nm {
		font-size: var(--fs-body);
		font-weight: 700;
		color: var(--ink);
	}
	.bio {
		margin-top: 4px;
		font-size: var(--fs-ui);
		color: var(--soft);
		line-height: var(--lh-body);
	}
	.lk {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		margin-top: var(--sp-3);
	}
	.lk a {
		display: inline-flex;
		align-items: center;
		height: 32px;
		padding: 0 var(--sp-3);
		border-radius: var(--r-btn);
		background: var(--fill);
		font-size: var(--fs-sub);
		font-weight: 600;
		color: var(--ink-2);
		transition: background-color 0.15s ease;
	}
	.lk a:hover {
		background: var(--fill-strong);
		color: var(--ink-2);
	}
	.pn {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-2);
		margin-top: var(--sp-6);
	}
	.pn a {
		display: flex;
		flex-direction: column;
		padding: var(--sp-4) var(--sp-5);
		border: 1px solid var(--line);
		border-radius: var(--r-card);
		color: inherit;
		transition: background-color 0.15s ease;
	}
	.pn a:hover {
		background: var(--bg-sub);
	}
	.pn .lb {
		font-size: var(--fs-sub);
		color: var(--soft);
	}
	.pn .tt {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin-top: 4px;
		font-size: var(--fs-body);
		font-weight: 600;
		color: var(--ink);
